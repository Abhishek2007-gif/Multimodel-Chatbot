# ==============================================================
# Multimodal AI Chatbot MVP - Environment Variables
# ==============================================================

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (PostgreSQL with pgvector)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/multimodal_chat
# For local development or testing without Postgres running, SQLite fallback is supported:
DATABASE_URL=sqlite+aiosqlite:///./multimodal_chat.db
# For production PostgreSQL with pgvector, uncomment:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multimodal_chat

# AI Model Provider
# Options: "openai" (default), "mock" (for zero-cost offline development & testing)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Audio Models
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Media Generation (Image & Video)
IMAGE_PROVIDER=pollinations
OPENAI_IMAGE_MODEL=dall-e-3
VIDEO_PROVIDER=pollinations

# Web Search Provider
# Options: "tavily" or "duckduckgo" (free fallback without API key)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# RAG Configuration
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.60

# File Upload Limits
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=./uploads
